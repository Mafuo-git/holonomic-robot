        "func": "// utilisateurs\nconst users = {\n    admin: { password: \"R_holonome_2025*\", role: \"admin\" },\n    public: { password: \"public1234\", role: \"public\" }\n};\n\n// Avec ui_form, les données arrivent ici :\nlet username = msg.payload.username;\nlet password = msg.payload.password;\n\n// sécurité\nif (!username || !password) {\n    msg.payload = \"Champs manquants\";\n    return msg;\n}\n\n// vérification\nif (users[username] && users[username].password === password) {\n    flow.set(\"user\", {\n        name: username,\n        role: users[username].role,\n        logged: true\n    });\n\n    msg.payload = \"Login réussi\";\n} else {\n    flow.set(\"user\",{logged:false});\n    msg.payload = \"Login échoué\";\n}\n\nreturn msg;\n",
