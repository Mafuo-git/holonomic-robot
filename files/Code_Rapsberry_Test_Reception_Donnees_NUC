import rclpy

from rclpy.node import Node

from std_msgs.msg import String

import paho.mqtt.publish as publish


class RosToMqtt(Node):


    def __init__(self):


    super().__init__('ros_to_mqtt')

    self.create_subscription(String, '/test', self.callback, 10)


def callback(self, msg):
    publish.single("robot/test", msg.data, hostname="localhost")


def main():


    rclpy.init()

    node = RosToMqtt()

    rclpy.spin(node)

if __name__ == '__main__':

    main()
