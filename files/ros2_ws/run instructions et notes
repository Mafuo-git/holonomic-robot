#packages to install manually (not required to use the teleop with node red):
nav2 : https://docs.nav2.org/tutorials/docs/navigation2_with_slam.html#
micro_ros : https://github.com/micro-ROS/micro_ros_setup

source /opt/ros/jazzy/setup.bash
cd ~/holonomic-robot/files/ros2_ws/
git clone -b $ROS_DISTRO https://github.com/micro-ROS/micro_ros_setup.git src/micro_ros_setup
rosdep update && rosdep install --from-paths src --ignore-src -y
colcon build
source install/setup.bash

# create the micro-ROS agent (not required for now since the ESP32 will not be used, but useful for future development):
ros2 run micro_ros_setup create_agent_ws.sh
ros2 run micro_ros_setup build_agent.sh
source install/local_setup.sh
ros2 run micro_ros_agent micro_ros_agent [parameters]


# after manually installing packages, build the workspace (will take some time since all dependencies will be installed):
cd ~/holonomic-robot/files/ros2_ws/
source opt/ros/jazzy/setup.bash
rosdep install -i --from-path src --rosdistro jazzy -y
rosdep install -y \
  --from-paths ./src \
  --ignore-src
colcon build

# to run nodes or launch files after building the workspace:
cd ~/holonomic-robot/files/ros2_ws/
source /opt/ros/jazzy/setup.bash
source install/setup.bash
ros2 run <package_name> <executable_name>
ros2 launch <package_name> <launch_file>.launch.py


# examples for motor control package:
ros2 launch cpp_motors_control motors_control.launch.py ==> lance le controle des moteurs
ros2 launch cpp_motors_control teleop_keyboard.launch.py ==> lance le controle des moteurs + teleop clavier
ros2 launch cpp_motors_control teleop_node_red.launch.py ==> lance le controle des moteurs + teleop node red


# instructions to create an autorun for the teleop with node red:

nano ~/start_ros2_teleop.sh

# fill the file with the content of /sample_files_NUC/start_ros2_teleop.sh, 
# remember to replace the package and file names in the last line with the ones you want to launch, 
# here the teleop with node red launch file is used as an example, 
# but you can replace it with any launch file you want to run at startup, 
# then save and exit (Ctrl + O, Enter, Ctrl + X), and make the script executable:

chmod +x ~/start_ros2_teleop.sh


nano /etc/systemd/system/ros2-teleop.service

# /!\ Replace isen with the user name, for example 'pi' or 'isen' and 
# replace the path to the script if you saved it in a different location, 
# then save and exit (Ctrl + O, Enter, Ctrl + X):

systemctl daemon-reexec
systemctl enable ros2-teleop.service
systemctl start ros2-teleop.service


# useful commands to manage the service:
systemctl status ros2-teleop.service  #(to verify that the service is running)
journalctl -u ros2-teleop.service -f  #(to follow the service logs)
systemctl restart ros2-teleop.service #(to restart the service)
systemctl disable ros2-teleop.service #(to disable automatic startup at boot)
systemctl stop ros2-teleop.service    #(to stop the service)
sudo loginctl enable-linger TON_USER         #(to allow the user service to start at boot even if the user is not logged in)


